<?xml version="1.0" encoding="utf-8"?>
<!-- The session/verification store is encrypted with a non-exportable Android Keystore key, so a
     restored copy could never be decrypted: keep it out of cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="librespydus_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="librespydus_secure.xml" />
    </device-transfer>
</data-extraction-rules>
