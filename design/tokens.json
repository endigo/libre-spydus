    "textPrimary": "#FFFFFF",
    "textSecondary": "#A4A7C1",
    "textMuted": "#7D809B",
    "primary": "#F2665E",
    "primaryGradientStart": "#F7806F",
    "primaryGradientEnd": "#EF5A5C",
    "onPrimary": "#FFFFFF",
    "accent": "#4B5BD6",
    "onAccent": "#FFFFFF",
    "sheet": "#FFFFFF",
    "onSheet": "#24263A",
    "onSheetSecondary": "#5F627A",
    "chipOnSheet": "#EEF0F7",
    "tabBar": "#FFFFFF",
    "tabActive": "#2B2D42",
    "tabInactive": "#B4B6C6",
    "success": "#3CC48A",
    "warning": "#F5A524",
    "danger": "#F2665E",
    "digital": "#2EC4B6",
