  "cover": { "aspect": 0.68, "shelfWidth": 120, "smallWidth": 72, "detailWidth": 140 },
  "tabBar": { "height": 64 },
  "shadow": {
    "card":      { "color": "#000000", "opacity": 0.25, "radius": 12, "y": 6 },
